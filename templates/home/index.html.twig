    <!-- Call to Action -->
    <section class="cta-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <h2>Envie d'une pizza délicieuse ?</h2>
                    <p class="lead">Venez nous rendre visite pour déguster nos délicieuses pizzas !</p>
                    <div class="text-center mt-4">
                        <a href="{{ path('app_pizzas') }}" class="btn btn-primary btn-lg"><i class="bi bi-journal-text me-2"></i>Carte de nos pizzas</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Actualités -->
    {% if news is not empty %}
    <section class="py-5 bg-dark-surface">
        <div class="container">
            <h2 class="section-title mb-5 text-white">Nos Actualités</h2>
            <div class="row">
                {% for item in news %}
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 bg-dark text-white border-secondary shadow-sm hover-lift">
                            {% if item.image %}
                                <img src="{{ asset('images/news/' ~ item.image) }}" class="card-img-top" alt="{{ item.title }}" style="height: 220px; object-fit: cover;">
                            {% endif %}
                            <div class="card-body d-flex flex-column">
                                <div class="mb-2">
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3">Actu</span>
                                    <small class="text-white-50 ms-2">{{ item.createdAt|date('d/m/Y') }}</small>
                                </div>
                                <h5 class="card-title fw-bold mt-2">{{ item.title }}</h5>
                                <p class="card-text text-white-50 flex-grow-1">{{ item.content|slice(0, 120) ~ '...' }}</p>
                                <a href="{{ path('app_news_detail', {'slug': item.slug}) }}" class="btn btn-link text-primary p-0 mt-3 text-decoration-none fw-bold">
                                    Lire la suite <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}
{% endblock %}
