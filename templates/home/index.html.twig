{# Template de la page d'accueil. Hérite de base.html.twig #}
{% extends 'base.html.twig' %}

{# Définition du titre de la page #}
{% block title %}Pizza Rico - Castelsarrasin{% endblock %}

{% block body %}
    {# Inclusion de la section Hero (bannière dynamique) #}
    {% include "Components/hero/hero.html.twig" %}

<!-- À propos -->
    <section class="bg-dark-surface">
        <div class="container-fluid px-0">
            <div class="row g-0 align-items-stretch">
                <div class="col-lg-6 p-5">
                    <div class="about-content">
                        <h2 class="section-title">Notre Histoire</h2>
                        <p>Fondée en 2005 par la famille Rico, notre pizzeria s'est donnée pour mission de faire découvrir les saveurs authentiques de l'Italie à Paris.</p>
                        <p>Nos pizzas sont préparées à la main avec des ingrédients frais et de qualité, importés directement d'Italie ou sélectionnés chez des producteurs locaux.</p>
                        <p>Notre four à bois traditionnel nous permet de cuire nos pizzas à haute température, garantissant une pâte croustillante à l'extérieur et moelleuse à l'intérieur.</p>
                    </div>
                </div>
                <div class="col-lg-6 about-image-container">
                    <img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5" alt="Notre pizzeria" class="about-image">
                </div>
            </div>
        </div>
    </section>

    <!-- Nos Spécialités -->
    <section class="py-5">
        <div class="container">
            <h2 class="section-title mb-5">Nos Spécialités</h2>
            <div class="row">
                {# Vérifie s'il y a des pizzas spéciales à afficher #}
                {% if specialPizzas is empty %}
                    <div class="col-12 text-center">
                        <p class="lead">Nos spécialités seront bientôt disponibles !</p>
                    </div>
                {% else %}
                    {# Boucle sur les pizzas spéciales pour les afficher sous forme de cartes #}
                    {% for pizza in specialPizzas %}
                        <div class="col-12 col-sm-6 col-lg-4 mb-4">
                            <div class="menu-card h-100">
                                {% if pizza.image %}
                                    <img src="{{ asset('images/pizzas/' ~ pizza.image) }}" class="card-img-top" alt="{{ pizza.name }}">
                                {% else %}
                                    <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38" class="card-img-top" alt="{{ pizza.name }}">
                                {% endif %}
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">{{ pizza.name }}</h5>
                                    <p class="ingredients flex-grow-1">{{ pizza.ingredient }}</p>
                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-muted small">Petite</span>
                                            <span class="dotted-line flex-grow-1 mx-2"></span>
                                            <span class="price">{{ pizza.priceMedium|number_format(2, ',', '') }} €</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-muted small">Grande</span>
                                            <span class="dotted-line flex-grow-1 mx-2"></span>
                                            <span class="price">{{ pizza.priceLarge|number_format(2, ',', '') }} €</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </section>

