{# Template de la page d'accueil. Hérite de base.html.twig #}
{% extends 'base.html.twig' %}

{# Définition du titre de la page #}
{% block title %}{{ seo.metaTitle|default('Pizza Rico - Castelsarrasin') }}{% endblock %}

{% block meta_description %}{{ seo.metaDescription|default('Pizza Rico : Les meilleures pizzas artisanales de Castelsarrasin. Ingrédients frais et pâte maison.') }}{% endblock %}

{% block body %}
    {# Inclusion de la section Hero (bannière dynamique) #}
    {% include "Components/hero/hero.html.twig" %}

<!-- À propos -->
    <section class="py-5 bg-dark-surface">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="about-image-wrapper position-relative">
                        <img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5" alt="Notre pizzeria" class="img-fluid rounded-4 shadow-lg about-img-main">
                        <div class="about-experience-badge bg-secondary text-white p-4 rounded-4 shadow position-absolute bottom-0 end-0 transform-translate-middle-y">
                            <span class="d-block h2 fw-bold mb-0">20+</span>
                            <span class="small text-uppercase">Ans d'expérience</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="about-content ps-lg-4">
                        <h6 class="text-secondary text-uppercase fw-bold mb-3">Découvrez notre univers</h6>
                        <h2 class="display-5 fw-bold mb-4 text-white">{{ about.title|default('Notre Histoire') }}</h2>
                        <div class="text-white-50 lead mb-4">
                            {% if about %}
                                {{ about.content|nl2br }}
                            {% else %}
                                <p>Fondée en 1995 par la famille Rico, notre pizzeria s'est donnée pour mission de faire découvrir les saveurs authentiques de l'Italie à Paris.</p>
                                <p>Nos pizzas sont préparées à la main avec des ingrédients frais et de qualité, importés directement d'Italie ou sélectionnés chez des producteurs locaux.</p>
                            {% endif %}
                        </div>
                        <div class="row g-4 mb-5">
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0 bg-primary-subtle p-3 rounded-circle me-3">
                                        <i class="bi bi-fire text-primary h4 mb-0"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0 text-white fw-bold">Cuisson Traditionnelle</h6>
                                        <small class="text-white-50">Four à bois authentique</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0 bg-success-subtle p-3 rounded-circle me-3">
                                        <i class="bi bi-patch-check text-success h4 mb-0"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0 text-white fw-bold">Ingrédients Frais</h6>
                                        <small class="text-white-50">Sélection locale</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <a href="{{ path('app_pizzas') }}" class="btn btn-outline-primary btn-lg px-4 rounded-pill">
                            Découvrir notre carte <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Nos Spécialités -->
    <section class="py-5">
        <div class="container">
            <h2 class="section-title mb-5">Nos Spécialités</h2>
            <div class="row">
                {# Vérifie s'il y a des pizzas spéciales à afficher #}
                {% if specialPizzas is empty %}
                    <div class="col-12 text-center">
                        <p class="lead">Nos spécialités seront bientôt disponibles !</p>
                    </div>
                {% else %}
                    {# Boucle sur les pizzas spéciales pour les afficher sous forme de cartes #}
                    {% for pizza in specialPizzas %}
                        <div class="col-12 col-sm-6 col-lg-4 mb-4">
                            <div class="menu-card h-100">
                                {% if pizza.image %}
                                    <img src="{{ asset('images/pizzas/' ~ pizza.image) }}" class="card-img-top" alt="{{ pizza.name }}">
                                {% else %}
                                    <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38" class="card-img-top" alt="{{ pizza.name }}">
                                {% endif %}
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">{{ pizza.name }}</h5>
                                    <p class="ingredients flex-grow-1">{{ pizza.ingredient }}</p>
                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-muted small">Petite</span>
                                            <span class="dotted-line flex-grow-1 mx-2"></span>
                                            <span class="price">{{ pizza.priceMedium|number_format(2, ',', '') }} €</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-muted small">Grande</span>
                                            <span class="dotted-line flex-grow-1 mx-2"></span>
                                            <span class="price">{{ pizza.priceLarge|number_format(2, ',', '') }} €</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </section>

    <!-- Témoignages -->
