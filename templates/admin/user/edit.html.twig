{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="admin-main-content">
    <div class="d-flex justify-content-between align-items-center page-title-box">
        <div>
            <h1 class="mb-1">{{ title }}</h1>
            <p class="text-muted mb-0">Gérez les accès et les informations personnelles des utilisateurs.</p>
        </div>
        <a href="{{ path('app_admin_user') }}" class="btn-admin btn-admin-secondary">
            <i class="bi bi-arrow-left"></i>
            <span>Retour à la liste</span>
        </a>
    </div>

    <div class="row">
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0 fw-bold text-primary">Informations du compte</h5>
                </div>
                <div class="card-body p-4">
                    {{ form_start(form, {'attr': {'class': 'admin-form'}}) }}
                        <div class="row g-4">
                            <div class="col-12">
                                {{ form_row(form.email) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.firstname) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.name) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.roles) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.password) }}
                                <div class="form-text text-muted">Laissez vide pour conserver le mot de passe actuel.</div>
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-end mt-5 pt-3 border-top border-light">
                            <button type="submit" class="btn-admin btn-admin-success px-5">
                                <i class="bi bi-check-lg"></i>
                                <span>Enregistrer les modifications</span>
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        
        <div class="col-12 col-xl-4 mt-4 mt-xl-0">
            <div class="card border-0 shadow-sm mb-4 bg-primary-soft">
                <div class="card-body p-4 text-center">
                    <div class="stats-icon mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <h5 class="fw-bold mb-1">{{ form.firstname.vars.value }} {{ form.name.vars.value }}</h5>
                    <p class="text-muted small mb-0">{{ form.email.vars.value }}</p>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-shield-lock me-2"></i>Rôles & Permissions</h6>
                    <p class="text-muted small">
                        Le rôle <strong>ROLE_ADMIN</strong> donne un accès complet à l'interface d'administration. 
                        Le rôle <strong>ROLE_USER</strong> est le rôle par défaut pour les clients.
                    </p>
                    <div class="alert alert-warning small mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i> Attention à ne pas vous retirer vos propres droits d'administration.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
