{% extends 'layout.html.twig' %}

{% block title %}{{ title|default('Gestion des Pizzas') }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
<!-- Delete Pizza Modal -->
<div class="modal fade" id="deletePizzaModal" tabindex="-1" aria-labelledby="deletePizzaModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deletePizzaModalLabel">Confirmation de suppression</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Êtes-vous sûr de vouloir supprimer cette pizza ?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-admin btn-admin-secondary" data-bs-dismiss="modal"><i class="bi bi-x-circle me-1"></i>Annuler</button>
        <form id="deleteForm" method="post" action="">
            <input type="hidden" name="_token" value="" id="deleteToken">
            <button type="submit" class="btn-admin btn-admin-danger"><i class="bi bi-trash me-1"></i>Supprimer</button>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="admin-main-content p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">{{ title|default('Gestion des Pizzas') }}</h1>
        <div class="d-flex gap-2">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-white"><i class="bi bi-search"></i></span>
                <input type="text" id="adminSearch" class="form-control bg-dark text-white border-secondary" placeholder="Rechercher une pizza...">
            </div>
            <a href="{{ path('app_admin_pizza_create') }}" class="btn-admin btn-admin-primary text-nowrap"><i class="bi bi-plus-circle me-2"></i>Ajouter une pizza</a>
        </div>
    </div>
    
    <!-- Pizzas List -->
    <div class="card shadow-sm">
        <div class="card-header py-3">
            <h5 class="mb-0 fw-bold">Pizzas</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="admin-table table-hover mb-0">
                    <thead>
                        <tr>
                            <th width="100">Image</th>
                            <th>Nom</th>
                            <th>Ingrédients</th>
                            <th>Prix (M/L)</th>
                            <th>Spéciale</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for pizza in pizzas %}
                        <tr>
                            <td>
                                <div class="pizza-thumbnail">
                                    {% if pizza.image %}
                                        <img src="{{ asset('images/pizzas/' ~ pizza.image) }}" alt="{{ pizza.name }}">
                                    {% else %}
                                        <div class="placeholder-image"><i class="bi bi-pizza"></i></div>
                                    {% endif %}
                                </div>
                            </td>
                            <td>{{ pizza.name }}</td>
                            <td>
                                <div class="text-truncate" title="{{ pizza.ingredient }}">
                                    {{ pizza.ingredient }}
                                </div>
                            </td>
                            <td>
                                {{ pizza.priceMedium|number_format(2, ',', '') }}€ / {{ pizza.priceLarge|number_format(2, ',', '') }}€
                            </td>
                            <td>
                                <span class="badge-status {% if pizza.isSpecial %}badge-processing{% else %}badge-pending{% endif %}">
                                    {% if pizza.isSpecial %}Spéciale{% else %}Standard{% endif %}
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a href="{{ path('app_admin_pizza_edit', {'slug': pizza.slug}) }}" class="btn-admin btn-admin-success btn-sm"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn-admin btn-admin-danger btn-sm delete-pizza" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#deletePizzaModal" 
                                        data-pizza-id="{{ pizza.id }}"
                                        data-delete-url="{{ path('app_admin_pizza_delete', {'id': pizza.id}) }}"
                                        data-token="{{ csrf_token('delete' ~ pizza.id) }}">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Handle delete pizza modal
        const deletePizzaButtons = document.querySelectorAll('.delete-pizza');
        const deleteForm = document.getElementById('deleteForm');
        const deleteToken = document.getElementById('deleteToken');
        
        deletePizzaButtons.forEach(button => {
            button.addEventListener('click', function() {
                const deleteUrl = this.getAttribute('data-delete-url');
                const token = this.getAttribute('data-token');
                
                deleteForm.setAttribute('action', deleteUrl);
                deleteToken.setAttribute('value', token);
            });
        });

        // Live Search
        const searchInput = document.getElementById('adminSearch');
        const tableRows = document.querySelectorAll('.admin-table tbody tr');

        searchInput.addEventListener('input', function() {
            const query = this.value.toLowerCase();
            tableRows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        });
    });
</script>
{% endblock %}
