{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="admin-layout">
    {% include 'AdminComponents/adminSidebar/adminSidebar.html.twig' %}
    
    <div class="admin-content" id="adminContent">
        <div class="admin-main-content p-4">
            <h1 class="mb-4">{{ title }}</h1>
            
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb bg-dark p-3 rounded">
                    <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}" class="text-decoration-none text-white">Tableau de bord</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_admin_news') }}" class="text-decoration-none text-white">Actualités</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Ajouter</li>
                </ol>
            </nav>

            <div class="row">
                <div class="col-12 col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-body p-4">
                            {{ form_start(form, {'attr': {'class': 'admin-form'}}) }}
                                <div class="mb-4">
                                    {{ form_label(form.title, null, {'label_attr': {'class': 'form-label fw-bold text-white-50 small text-uppercase'}}) }}
                                    {{ form_widget(form.title) }}
                                    {{ form_errors(form.title) }}
                                </div>
                                <div class="mb-4">
                                    {{ form_label(form.content, null, {'label_attr': {'class': 'form-label fw-bold text-white-50 small text-uppercase'}}) }}
                                    {{ form_widget(form.content, {'attr': {'rows': 15}}) }}
                                    {{ form_errors(form.content) }}
                                </div>
                                <div class="mb-4">
                                    {{ form_label(form.imageFile, null, {'label_attr': {'class': 'form-label fw-bold text-white-50 small text-uppercase'}}) }}
                                    {{ form_widget(form.imageFile) }}
                                    {{ form_errors(form.imageFile) }}
                                </div>
                                <div class="d-flex justify-content-between pt-3 border-top border-secondary">
                                    <a href="{{ path('app_admin_news') }}" class="btn-admin btn-admin-secondary">
                                        <i class="bi bi-x-circle me-2"></i>Annuler
                                    </a>
                                    <button type="submit" class="btn-admin btn-admin-primary">
                                        <i class="bi bi-check-circle me-2"></i>Publier l'actualité
                                    </button>
                                </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
