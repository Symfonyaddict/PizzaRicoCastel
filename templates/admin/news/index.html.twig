{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="admin-layout">
    {% include 'AdminComponents/adminSidebar/adminSidebar.html.twig' %}
    
    <div class="admin-content" id="adminContent">
        <div class="admin-main-content p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="mb-0">{{ title }}</h1>
                <a href="{{ path('app_admin_news_create') }}" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle me-2"></i>Nouvel article</a>
            </div>
            
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb bg-dark p-3 rounded">
                    <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}" class="text-decoration-none text-white">Tableau de bord</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Actualités</li>
                </ol>
            </nav>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-check-circle me-2"></i> {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="admin-table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Image</th>
                                    <th>Titre</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in news %}
                                <tr>
                                    <td>
                                        {% if item.image %}
                                            <img src="{{ asset('images/news/' ~ item.image) }}" class="img-thumbnail" width="50">
                                        {% else %}
                                            <div class="placeholder-image"><i class="bi bi-newspaper"></i></div>
                                        {% endif %}
                                    </td>
                                    <td>{{ item.title }}</td>
                                    <td>{{ item.createdAt|date('d/m/Y') }}</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a href="{{ path('app_admin_news_edit', {'slug': item.slug}) }}" class="btn-admin btn-admin-success btn-sm"><i class="bi bi-pencil"></i></a>
                                            <form method="post" action="{{ path('app_admin_news_delete', {'id': item.id}) }}" onsubmit="return confirm('Supprimer cet article ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
                                                <button type="submit" class="btn-admin btn-admin-danger btn-sm"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="4" class="text-center py-4">Aucune actualité.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
