{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="admin-main-content">
    <div class="d-flex justify-content-between align-items-center page-title-box">
        <div>
            <h1 class="mb-1">{{ title }}</h1>
            <p class="text-muted mb-0">Publiez et gérez les actualités de Pizza Rico.</p>
        </div>
        <a href="{{ path('app_admin_news_create') }}" class="btn-admin btn-admin-primary">
            <i class="bi bi-plus-lg"></i>
            <span>Nouvel article</span>
        </a>
    </div>
    
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Aperçu</th>
                            <th>Titre</th>
                            <th>Date de publication</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in news %}
                        <tr>
                            <td>
                                <div class="pizza-thumbnail">
                                    {% if item.image %}
                                        <img src="{{ asset('images/news/' ~ item.image) }}" alt="{{ item.title }}">
                                    {% else %}
                                        <div class="h-100 w-100 d-flex align-items-center justify-content-center bg-dark">
                                            <i class="bi bi-newspaper text-muted"></i>
                                        </div>
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                <span class="fw-bold">{{ item.title }}</span>
                            </td>
                            <td class="text-muted">
                                <i class="bi bi-calendar3 me-2"></i>{{ item.createdAt|date('d/m/Y') }}
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a href="{{ path('app_admin_news_edit', {'slug': item.slug}) }}" class="btn-admin btn-admin-secondary btn-sm" title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('app_admin_news_delete', {'id': item.id}) }}" onsubmit="return confirm('Supprimer cet article ?');" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
                                        <button type="submit" class="btn-admin btn-admin-danger btn-sm" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">Aucune actualité trouvée.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
