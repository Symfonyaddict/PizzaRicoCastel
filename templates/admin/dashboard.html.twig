{# Template principal du tableau de bord d'administration #}
{% extends 'layout.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<div class="admin-main-content">
    <div class="page-title-box">
        {% if app.user %}
            <h1>Bienvenue, {{ app.user.firstname }}</h1>
        {% else %}
            <h1>Tableau de bord</h1>
        {% endif %}
        <p class="text-muted">Voici un aperçu de l'activité de Pizza Rico.</p>
    </div>

    <!-- Statistiques rapides -->
    <div class="stats-grid">
        <div class="stats-card">
            <div class="stats-icon"><i class="bi bi-people"></i></div>
            <div class="stats-info">
                <div class="stats-title">Utilisateurs</div>
                <div class="stats-value">{{ totalUsers }}</div>
            </div>
        </div>
        
        <div class="stats-card">
            <div class="stats-icon"><i class="bi bi-pizza"></i></div>
            <div class="stats-info">
                <div class="stats-title">Pizzas</div>
                <div class="stats-value">{{ totalPizzas }}</div>
                <div class="small text-muted">{{ specialPizzas }} spéciales</div>
            </div>
        </div>
        
        <div class="stats-card">
            <div class="stats-icon"><i class="bi bi-cup-straw"></i></div>
            <div class="stats-info">
                <div class="stats-title">Boissons</div>
                <div class="stats-value">{{ totalBoissons }}</div>
            </div>
        </div>
        
        <div class="stats-card">
            <div class="stats-icon"><i class="bi bi-tag"></i></div>
            <div class="stats-info">
                <div class="stats-title">Prix moyen Pizza</div>
                <div class="stats-value">{{ avgPizzaPrice|number_format(2, ',', '') }}€</div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="stats-icon bg-info-subtle text-info rounded-circle" style="width: 40px; height: 40px; background: rgba(59, 130, 246, 0.1);">
                        <i class="bi bi-info-circle"></i>
                    </div>
                    <div>
                        <h6 class="mb-1 fw-bold">Besoin d'aide ?</h6>
                        <p class="mb-0 text-muted small">Utilisez le menu latéral pour gérer les pizzas, boissons, actualités et le SEO de votre site.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
