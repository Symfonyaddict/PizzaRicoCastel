{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="admin-layout">
    {% include 'AdminComponents/adminSidebar/adminSidebar.html.twig' %}

    <div class="admin-content" id="adminContent">
        <div class="admin-main-content p-4">
            <h1 class="mb-4">{{ title }}</h1>

            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb bg-dark p-3 rounded">
                    <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}" class="text-decoration-none text-white">Tableau de bord</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Mentions Légales</li>
                </ol>
            </nav>

            <div class="row">
                <div class="col-12 col-lg-7">
                    <div class="card shadow-sm">
                        <div class="card-header py-3">
                            <h5 class="mb-0 fw-bold text-white"><i class="bi bi-file-earmark-text me-2"></i>Édition des mentions légales</h5>
                        </div>
                        <div class="card-body p-4">
                            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                                <div class="mb-4">
                                    {{ form_label(form.metaTitle, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.metaTitle, {'attr': {'class': 'form-control'}}) }}
                                    <div class="form-text">Titre affiché dans l'onglet du navigateur et dans les résultats Google (~50-60 caractères).</div>
                                </div>
                                <div class="mb-4">
                                    {{ form_label(form.metaDescription, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.metaDescription, {'attr': {'class': 'form-control'}}) }}
                                    <div class="form-text">Optionnel — Courte description SEO affichée sous le titre dans les moteurs de recherche.</div>
                                </div>
                                <div class="mb-4">
                                    {{ form_label(form.title, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.title, {'attr': {'class': 'form-control form-control-lg'}}) }}
                                    <div class="form-text">Grand titre H1 visible en haut de la page publique /mentions-legales.</div>
                                </div>
                                <div class="mb-4">
                                    {{ form_label(form.content, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.content, {'attr': {'class': 'form-control', 'rows': 16}}) }}
                                    <div class="form-text">Éditeur, directeur de publication, hébergeur, propriété intellectuelle, données personnelles, contact, CGV, etc.</div>
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn-admin btn-admin-primary btn-lg"><i class="bi bi-save me-2"></i>Enregistrer les mentions légales</button>
                                </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-5">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header py-3">
                            <h5 class="mb-0 fw-bold text-white"><i class="bi bi-shield-check me-2"></i>Informations obligatoires</h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item border-0 px-0">
                                    <h6 class="fw-bold text-primary">Identité</h6>
                                    <p class="small text-muted mb-0">Raison sociale, SIRET/SIREN, siège social, capital social, numéro de TVA intracommunautaire.</p>
                                </li>
                                <li class="list-group-item border-0 px-0">
                                    <h6 class="fw-bold text-primary">Publication</h6>
                                    <p class="small text-muted mb-0">Directeur de publication, coordonnées du webmaster (email/téléphone).</p>
                                </li>
                                <li class="list-group-item border-0 px-0">
                                    <h6 class="fw-bold text-primary">Hébergement</h6>
                                    <p class="small text-muted mb-0">Nom, adresse postale et téléphone de l'hébergeur du site internet.</p>
                                </li>
                                <li class="list-group-item border-0 px-0">
                                    <h6 class="fw-bold text-primary">Propriété intellectuelle</h6>
                                    <p class="small text-muted mb-0">Droits d'auteur, reproduction, marques et logos visibles sur le site.</p>
                                </li>
                                <li class="list-group-item border-0 px-0">
                                    <h6 class="fw-bold text-primary">Données personnelles</h6>
                                    <p class="small text-muted mb-0">Durée de conservation, droits d'accès, rectification, suppression et opposition.</p>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="alert alert-info border-0 shadow-sm">
                        <h6 class="alert-heading fw-bold"><i class="bi bi-link-45deg me-2"></i>Aperçu public</h6>
                        <p class="mb-0 small"><a href="{{ path('app_mentions_legales') }}" target="_blank" rel="noopener" class="text-reset">Voir la page publique /mentions-legales</a>.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
