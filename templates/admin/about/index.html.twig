{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="admin-layout">
    {% include 'AdminComponents/adminSidebar/adminSidebar.html.twig' %}
    
    <div class="admin-content" id="adminContent">
        <div class="admin-main-content p-4">
            <h1 class="mb-4">{{ title }}</h1>
            
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb bg-dark p-3 rounded">
                    <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}" class="text-decoration-none text-white">Tableau de bord</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">À Propos</li>
                </ol>
            </nav>

            <div class="row">
                <div class="col-12 col-lg-7">
                    <div class="card shadow-sm">
                        <div class="card-header py-3">
                            <h5 class="mb-0 fw-bold text-white"><i class="bi bi-pencil-square me-2"></i>Édition du contenu</h5>
                        </div>
                        <div class="card-body p-4">
                            {{ form_start(form) }}
                                <div class="mb-4">
                                    {{ form_label(form.title, 'Titre de la section', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.title, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Ex: Notre Histoire'}}) }}
                                    <div class="form-text">C'est le titre principal qui apparaîtra sur la page d'accueil.</div>
                                </div>
                                <div class="mb-4">
                                    {{ form_label(form.content, 'Contenu textuel', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.content, {'attr': {'class': 'form-control', 'rows' : 12, 'placeholder': 'Racontez votre histoire ici...'}}) }}
                                    <div class="form-text">Utilisez des sauts de ligne pour séparer vos paragraphes.</div>
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn-admin btn-admin-primary btn-lg"><i class="bi bi-save me-2"></i>Mettre à jour la présentation</button>
                                </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
                
                <div class="col-12 col-lg-5">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header py-3">
                            <h5 class="mb-0 fw-bold text-white"><i class="bi bi-lightbulb me-2"></i>Conseils de rédaction</h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item border-0 px-0">
                                    <h6 class="fw-bold text-primary">Soyez authentique</h6>
                                    <p class="small text-muted">Racontez l'origine de votre pizzeria, vos valeurs et votre passion pour la cuisine italienne.</p>
                                </li>
                                <li class="list-group-item border-0 px-0">
                                    <h6 class="fw-bold text-primary">Mettez en avant vos produits</h6>
                                    <p class="small text-muted">Parlez de votre pâte maison, de vos ingrédients frais et de votre cuisson au feu de bois.</p>
                                </li>
                                <li class="list-group-item border-0 px-0">
                                    <h6 class="fw-bold text-primary">Structurez votre texte</h6>
                                    <p class="small text-muted">Faites des phrases courtes et des paragraphes aérés pour une lecture agréable sur mobile.</p>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="alert alert-warning border-0 shadow-sm">
                        <h6 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Note importante</h6>
                        <p class="mb-0 small">Cette section est cruciale pour votre image de marque. Elle aide vos clients à vous faire confiance et à comprendre ce qui vous rend unique.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
