{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="admin-main-content">
    <div class="page-title-box">
        <h1 class="mb-1">{{ title }}</h1>
        <p class="text-muted mb-0">Racontez l'histoire de Pizza Rico et partagez vos valeurs.</p>
    </div>

    <div class="row">
        <div class="col-12 col-xl-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0 fw-bold text-primary">Contenu de la section</h5>
                </div>
                <div class="card-body p-4">
                    {{ form_start(form, {'attr': {'class': 'admin-form'}}) }}
                        <div class="mb-4">
                            {{ form_row(form.title) }}
                        </div>
                        <div class="mb-4">
                            {{ form_row(form.content) }}
                        </div>
                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn-admin btn-admin-success px-5">
                                <i class="bi bi-save me-2"></i>Mettre à jour
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        
        <div class="col-12 col-xl-5 mt-4 mt-xl-0">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-lightbulb me-2"></i>Conseils de rédaction</h6>
                    <div class="d-flex gap-3 mb-3">
                        <div class="stats-icon rounded-circle flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.8rem;">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <div>
                            <h6 class="mb-1 fw-bold">Soyez authentique</h6>
                            <p class="small text-muted mb-0">Racontez l'origine de votre pizzeria et votre passion.</p>
                        </div>
                    </div>
                    <div class="d-flex gap-3 mb-3">
                        <div class="stats-icon rounded-circle flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.8rem;">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <div>
                            <h6 class="mb-1 fw-bold">Qualité des produits</h6>
                            <p class="small text-muted mb-0">Parlez de votre pâte maison et de vos ingrédients frais.</p>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="stats-icon rounded-circle flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.8rem;">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <div>
                            <h6 class="mb-1 fw-bold">Structure aérée</h6>
                            <p class="small text-muted mb-0">Faites des paragraphes courts pour une lecture facile sur mobile.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm bg-primary-soft">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-2 text-primary"><i class="bi bi-info-circle me-2"></i>Note</h6>
                    <p class="mb-0 small text-muted">Cette section aide vos clients à vous faire confiance et à comprendre ce qui vous rend unique.</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
