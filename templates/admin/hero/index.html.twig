{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="admin-main-content">
    <div class="d-flex justify-content-between align-items-center page-title-box">
        <div>
            <h1 class="mb-1">{{ title }}</h1>
            <p class="text-muted mb-0">Personnalisez les bannières d'accueil de votre site.</p>
        </div>
        <a href="{{ path('app_admin_hero_create') }}" class="btn-admin btn-admin-primary">
            <i class="bi bi-plus-lg"></i>
            <span>Nouvelle section</span>
        </a>
    </div>
    
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Aperçu</th>
                            <th>Titre Principal</th>
                            <th>Sous-titre</th>
                            <th>Statut</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for hero in heroes %}
                        <tr>
                            <td>
                                <div class="pizza-thumbnail" style="width: 80px;">
                                    {% if hero.image %}
                                        <img src="{{ asset('images/hero/' ~ hero.image) }}" alt="{{ hero.title }}">
                                    {% else %}
                                        <div class="h-100 w-100 d-flex align-items-center justify-content-center bg-dark">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                <span class="fw-bold">{{ hero.title }}</span>
                            </td>
                            <td>
                                <div class="text-truncate text-muted small" style="max-width: 200px;">
                                    {{ hero.subtitle }}
                                </div>
                            </td>
                            <td>
                                {% if hero.isActive %}
                                    <span class="badge-status badge-delivered">Actif</span>
                                {% else %}
                                    <span class="badge-status badge-pending">Inactif</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a href="{{ path('app_admin_hero_edit', {'id': hero.id}) }}" class="btn-admin btn-admin-secondary btn-sm" title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('app_admin_hero_delete', {'id': hero.id}) }}" onsubmit="return confirm('Supprimer cette section ?');" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ hero.id) }}">
                                        <button type="submit" class="btn-admin btn-admin-danger btn-sm" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">Aucune section hero configurée.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
