{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="admin-main-content">
    <div class="d-flex justify-content-between align-items-center page-title-box">
        <div>
            <h1 class="mb-1">{{ title }}</h1>
            <p class="text-muted mb-0">Mettez à jour les informations de cette boisson.</p>
        </div>
        <a href="{{ path('app_admin_boisson') }}" class="btn-admin btn-admin-secondary">
            <i class="bi bi-arrow-left"></i>
            <span>Retour à la liste</span>
        </a>
    </div>

    <div class="row">
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    {{ form_start(form, {'attr': {'class': 'admin-form'}}) }}
                        {{ form_widget(form) }}
                        <div class="d-flex justify-content-end mt-5 pt-3 border-top border-light">
                            <button type="submit" class="btn-admin btn-admin-success px-5">
                                <i class="bi bi-check-lg"></i>
                                <span>Enregistrer les modifications</span>
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        
        <div class="col-12 col-xl-4 mt-4 mt-xl-0">
            <div class="card border-0 shadow-sm bg-primary-soft">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-info-circle me-2"></i>Informations</h5>
                    <p class="text-muted small">
                        Les boissons sont classées par catégories (Sodas, Bières, Vins, etc.) pour faciliter la lecture du menu par les clients.
                    </p>
                    <hr class="opacity-10">
                    <div class="small text-muted">
                        <i class="bi bi-image me-2"></i> Format recommandé : 500x500px.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
