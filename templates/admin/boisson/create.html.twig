{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="admin-main-content">
    <div class="d-flex justify-content-between align-items-center page-title-box">
        <div>
            <h1 class="mb-1">{{ title }}</h1>
            <p class="text-muted mb-0">Ajoutez une nouvelle boisson à votre carte.</p>
        </div>
        <a href="{{ path('app_admin_boisson') }}" class="btn-admin btn-admin-secondary">
            <i class="bi bi-arrow-left"></i>
            <span>Retour à la liste</span>
        </a>
    </div>

    <div class="row">
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    {{ form_start(form, {'attr': {'class': 'admin-form'}}) }}
                        {{ form_widget(form) }}
                        <div class="d-flex justify-content-end mt-5 pt-3 border-top border-light">
                            <button type="submit" class="btn-admin btn-admin-primary px-5">
                                <i class="bi bi-plus-lg"></i>
                                <span>Créer la boisson</span>
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        
        <div class="col-12 col-xl-4 mt-4 mt-xl-0">
            <div class="card border-0 shadow-sm bg-primary-soft">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-lightbulb me-2"></i>Conseil</h5>
                    <p class="text-muted small">
                        Renseignez bien la contenance (ex: 33cl, 1.5L) pour informer vos clients au mieux.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
