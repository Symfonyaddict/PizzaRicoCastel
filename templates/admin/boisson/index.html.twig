{% extends 'layout.html.twig' %}

{% block title %}{{ title|default('Gestion des Boissons') }}{% endblock %}

{% block body %}
<!-- Delete Boisson Modal -->
<div class="modal fade" id="deleteBoissonModal" tabindex="-1" aria-labelledby="deleteBoissonModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header border-bottom-0 pt-4 px-4">
        <h5 class="modal-title fw-bold" id="deleteBoissonModalLabel">Supprimer cette boisson ?</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body px-4 py-3">
        <p class="text-muted">Êtes-vous sûr de vouloir supprimer cette boisson de la carte ?</p>
      </div>
      <div class="modal-footer border-top-0 pb-4 px-4">
        <button type="button" class="btn-admin btn-admin-secondary" data-bs-dismiss="modal">Annuler</button>
        <form id="deleteForm" method="post" action="">
            <input type="hidden" name="_token" value="" id="deleteToken">
            <button type="submit" class="btn-admin btn-admin-danger">Supprimer</button>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="admin-main-content">
    <div class="d-flex justify-content-between align-items-center page-title-box">
        <div>
            <h1 class="mb-1">{{ title|default('Gestion des Boissons') }}</h1>
            <p class="text-muted mb-0">Gérez les sodas, bières et autres boissons de votre établissement.</p>
        </div>
        <a href="{{ path('app_admin_boisson_create') }}" class="btn-admin btn-admin-primary">
            <i class="bi bi-plus-lg"></i>
            <span>Ajouter une boisson</span>
        </a>
    </div>
    
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Aperçu</th>
                            <th>Nom</th>
                            <th>Catégorie</th>
                            <th>Contenance</th>
                            <th>Prix</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for boisson in boissons %}
                        <tr>
                            <td>
                                <div class="pizza-thumbnail">
                                    {% if boisson.image %}
                                        <img src="{{ asset('images/boissons/' ~ boisson.image) }}" alt="{{ boisson.name }}">
                                    {% else %}
                                        <div class="h-100 w-100 d-flex align-items-center justify-content-center bg-dark">
                                            <i class="bi bi-cup-straw text-muted"></i>
                                        </div>
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                <span class="fw-bold">{{ boisson.name }}</span>
                            </td>
                            <td>
                                <span class="badge-status badge-processing">{{ boisson.category|default('Non classé') }}</span>
                            </td>
                            <td class="text-muted">{{ boisson.capacity|default('-') }}</td>
                            <td>
                                <span class="fw-bold text-primary">{{ boisson.price|number_format(2, ',', '') }}€</span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a href="{{ path('app_admin_boisson_edit', {'slug': boisson.slug}) }}" class="btn-admin btn-admin-secondary btn-sm" title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn-admin btn-admin-danger btn-sm delete-boisson" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#deleteBoissonModal" 
                                        data-delete-url="{{ path('app_admin_boisson_delete', {'id': boisson.id}) }}"
                                        data-token="{{ csrf_token('delete' ~ boisson.id) }}"
                                        title="Supprimer">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    Aucune boisson trouvée.
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const deleteButtons = document.querySelectorAll('.delete-boisson');
        const deleteForm = document.getElementById('deleteForm');
        const deleteToken = document.getElementById('deleteToken');
        
        deleteButtons.forEach(button => {
            button.addEventListener('click', function() {
                const deleteUrl = this.getAttribute('data-delete-url');
                const token = this.getAttribute('data-token');
                
                deleteForm.setAttribute('action', deleteUrl);
                deleteToken.setAttribute('value', token);
            });
        });
    });
</script>
{% endblock %}
