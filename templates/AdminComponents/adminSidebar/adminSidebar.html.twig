<div class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-header">
        <a href="{{ path('app_admin_dashboard') }}" class="sidebar-brand">
            <i class="bi bi-pizza"></i>
            <span>Pizza Rico</span>
        </a>
        <button class="d-lg-none btn-icon text-white" id="closeSidebarBtn">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    
    <div class="sidebar-nav">
        <a href="{{ path('app_admin_dashboard') }}" class="nav-link {{ 'app_admin_dashboard'|is_active_route }}">
            <i class="bi bi-speedometer2"></i>
            <span>Tableau de bord</span>
        </a>
        
        <div class="sidebar-divider"></div>
        
        <a href="{{ path('app_admin_pizza') }}" class="nav-link {{ 'app_admin_pizza'|is_active_route }}">
            <i class="bi bi-card-list"></i>
            <span>Pizzas</span>
        </a>
        <a href="{{ path('app_admin_boisson') }}" class="nav-link {{ 'app_admin_boisson'|is_active_route }}">
            <i class="bi bi-cup-straw"></i>
            <span>Boissons</span>
        </a>
        <a href="{{ path('app_admin_news') }}" class="nav-link {{ 'app_admin_news'|is_active_route }}">
            <i class="bi bi-newspaper"></i>
            <span>Actualités</span>
        </a>
        
        <div class="sidebar-divider"></div>
        
        <a href="{{ path('app_admin_hero') }}" class="nav-link {{ 'app_admin_hero'|is_active_route }}">
            <i class="bi bi-image"></i>
            <span>Sections Hero</span>
        </a>
        <a href="{{ path('app_admin_about') }}" class="nav-link {{ 'app_admin_about'|is_active_route }}">
            <i class="bi bi-info-circle"></i>
            <span>À Propos</span>
        </a>
        <a href="{{ path('app_admin_seo') }}" class="nav-link {{ 'app_admin_seo'|is_active_route }}">
            <i class="bi bi-search"></i>
            <span>SEO</span>
        </a>
        
        <div class="sidebar-divider"></div>
        
        <a href="{{ path('app_admin_user') }}" class="nav-link {{ 'app_admin_user'|is_active_route }}">
            <i class="bi bi-people"></i>
            <span>Utilisateurs</span>
        </a>
    </div>

    <div class="sidebar-footer">
        <div class="d-flex flex-column gap-2">
            {% if app.user %}
                <div class="nav-link text-warning mb-2 p-0" style="cursor: default; background: transparent !important; box-shadow: none !important;">
                    <i class="bi bi-person-circle"></i>
                    <span class="text-truncate">{{ app.user.firstname }}</span>
                </div>
            {% endif %}
            
            <a href="{{ path('app_home') }}" class="nav-link p-2">
                <i class="bi bi-house"></i>
                <span>Voir le site</span>
            </a>
            
            <a href="{{ path('app_logout') }}" class="nav-link p-2 text-danger">
                <i class="bi bi-box-arrow-right"></i>
                <span>Déconnexion</span>
            </a>
        </div>
    </div>
</div>
