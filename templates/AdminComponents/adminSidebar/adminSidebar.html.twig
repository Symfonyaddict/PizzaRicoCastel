<div class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-header">
        <a href="{{ path('app_admin_dashboard') }}" class="sidebar-brand">
            <i class="bi bi-pizza"></i>
            <span>Pizza Rico</span>
        </a>
        <button class="d-lg-none btn-icon text-white" id="closeSidebarBtn">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    
    <div class="mt-auto">
        <a href="{{ path('app_admin_dashboard') }}" class="nav-link {{ 'app_admin_dashboard'|is_active_route }}">
            <i class="bi bi-speedometer2"></i>
            <span>Tableau de bord</span>
        </a>
        <a href="{{ path('app_admin_pizza') }}" class="nav-link {{ 'app_admin_pizza'|is_active_route }}">
            <i class="bi bi-card-list"></i>
            <span>Gérer les Pizzas</span>
        </a>
        <a href="{{ path('app_admin_boisson') }}" class="nav-link {{ 'app_admin_boisson'|is_active_route }}">
            <i class="bi bi-cup-straw"></i>
            <span>Gérer les Boissons</span>
        </a>
        <a href="{{ path('app_admin_hero') }}" class="nav-link {{ 'app_admin_hero'|is_active_route }}">
            <i class="bi bi-image"></i>
            <span>Gérer les Sections Hero</span>
        </a>
        <a href="{{ path('app_admin_user') }}" class="nav-link {{ 'app_admin_user'|is_active_route }}">
            <i class="bi bi-people"></i>
            <span>Gérer les Utilisateurs</span>
        </a>
    </div>
    <hr>
    <div class="mt-auto">
        <a class="nav-link text-warning" href="{{ path('app_admin_user') }}">

            <i class="bi bi-person-circle"></i> 
            <span>
                {% if app.user %}
                    {{ app.user.firstname ~ ' ' ~ app.user.name }}
                {% endif %}
            </span>
        </a>
        
    </div>
    <div class="mt-auto">
        <a class="nav-link" href="{{ path('app_home') }}">

            <i class="bi bi-house"></i> 
            <span>
                Retour au site
            </span>
        </a>
    </div>
    <div class="mt-auto">
        <a class="nav-link" href="{{ path('app_logout') }}">

            <i class="bi bi-box-arrow-right"></i> 
            <span>
                Deconnexion
            </span>
        </a>
    </div>
</div>