{# Page publique des mentions légales. #}
{# Les données proviennent exclusivement de l'entité MentionsLegales (base). #}
{% extends 'base.html.twig' %}

{% block title %}{{ metaTitle|default('') }}{% endblock %}
{% block meta_description %}{{ metaDescription|default('') }}{% endblock %}

{% block body %}
<section class="row justify-content-center">
    <div class="col-lg-10">
        {% if title is defined and title is not empty %}
            <h1 class="mb-4">{{ title }}</h1>
        {% endif %}

        {% if content is defined and content is not empty %}
            <article class="prose">
                {{ content|nl2br }}
            </article>
        {% endif %}
    </div>
</section>
{% endblock %}
