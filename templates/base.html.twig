{# Template de base utilisé pour le site public. Définit la structure HTML commune. #}
<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Pizza Rico - Castelsarrasin{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Pizza Rico : Les meilleures pizzas artisanales de Castelsarrasin. Ingrédients frais et pâte maison.{% endblock %}">
        {% if app.environment != 'prod' %}
            <meta name="robots" content="noindex, nofollow">
        {% endif %}
        {% set canonical_base = app_canonical_base_url is defined ? app_canonical_base_url|trim('/', side='right') : '' %}
        {% if canonical_base is not empty and canonical_base starts with 'https://' and 'example.' not in canonical_base %}
            <link rel="canonical" href="{{ canonical_base ~ app.request.getRequestUri() }}">
        {% else %}
            <link rel="canonical" href="{{ app.request.getSchemeAndHttpHost() ~ app.request.getRequestUri() }}">
        {% endif %}

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🍕</text></svg>">
        {% block stylesheets %}
            <!-- Google Fonts -->
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
            <!-- Bootstrap 5 CSS CDN -->
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
            <!-- Bootstrap Icons -->
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
            <!-- Font Awesome -->
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <!-- Bootstrap 5 JS Bundle with Popper -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
            <!-- Scripts are now managed in app.js -->
        {% endblock %}
    </head>
    <body>
        <header>
            {% include "Components/navbar/navbar.html.twig" %}
        </header>

        <main class="container py-4">
            {% block body %}{% endblock %}
        </main>

        <footer class="pb-4">
            {% include "Components/footer/footer.html.twig" %}
        </footer>



        <!-- Scripts déplacés dans app.js -->
    </body>
</html>
