<!-- Responsive Navbar -->
            {# Barre de navigation principale avec gestion de l'état actif via l'extension Twig personnalisée #}
            <nav class="navbar navbar-expand-lg fixed-top">
                <div class="container">
                    <a class="navbar-brand" href="{{ path('app_home') }}">  <i class="fas fa-pizza-slice me-2"></i><span class="fw-bold">Pizza Rico</span></a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link {{ 'app_home'|is_active_route }}" aria-current="{{ 'app_home'|is_active_route ? 'page' : '' }}" href="{{ path('app_home') }}">Accueil</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link {{ 'app_pizzas'|is_active_route }}" aria-current="{{ 'app_pizzas'|is_active_route ? 'page' : '' }}" href="{{ path('app_pizzas') }}">Nos pizzas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link {{ 'app_boissons'|is_active_route }}" aria-current="{{ 'app_boissons'|is_active_route ? 'page' : '' }}" href="{{ path('app_boissons') }}">Nos boissons</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link {{ 'app_about'|is_active_route }}" aria-current="{{ 'app_about'|is_active_route ? 'page' : '' }}" href="{{ path('app_about') }}">À propos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link {{ 'app_news'|is_active_route or 'app_news_detail'|is_active_route }}" aria-current="{{ 'app_news'|is_active_route ? 'page' : '' }}" href="{{ path('app_news') }}">Actualités</a>
                            </li>
                            {% if app.user %}
                            <li class="nav-item">
                                <a class="nav-link {{ 'app_admin_dashboard'|is_active_route }}" aria-current="{{ 'app_admin_dashboard'|is_active_route ? 'page' : '' }}" href="{{ path ('app_admin_dashboard') }}">Administration</a>
                            </li>
                            {% endif %}
                        </ul>

                    </div>
                </div>
            </nav>