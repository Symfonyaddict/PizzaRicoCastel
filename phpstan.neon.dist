# Prérequis : générer le conteneur avant analyse
#   bin/console cache:warmup --env=dev
parameters:
    level: 5
    paths:
        - src
    excludePaths:
        - src/Kernel.php
    tmpDir: var/cache/phpstan
    reportUnmatchedIgnoredErrors: false
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
